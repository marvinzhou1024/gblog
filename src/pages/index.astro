---
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import BlogInsight from '@components/blog/BlogInsight.astro'
import HeroSection from '@components/ui/sections/HeroSection.astro'
import FeaturesSection from '@components/ui/sections/FeaturesSection.astro'
import HeroSectionAlt from '@components/ui/sections/HeroSectionAlt.astro'
import blogHeroImg from '@images/home.png'

const posts: CollectionEntry<'posts'>[] = (await getCollection('posts')).sort(
    (a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 3);
---

<BaseLayout>
    <HeroSection
        title=`码神, <span class="text-yellow-500 dark:text-yellow-400">跨境增长实战派</span>`
        subTitle="大家好，我是码神，擅长GoogleSEO与跨境增长，技术流、实战派，助力多家外贸工厂/公司独立站实现从0到1增长(千万销售额)，本身也从事B端跨境业务，组建了一支跨境实战家团队，为工厂、外贸企业提供完整的战略、建站、SEO、营销增长实战服务"
        primaryBtn="关于我"
        primaryBtnURL="/posts/about-me"
        secondaryBtn="联系我"
        secondaryBtnURL="联系我"
        src={blogHeroImg}
        alt="godruoyi's blog"
    />

    <FeaturesSection />
    <div class="flex justify-center items-center px-4 py-4">
        <a href="https://hostinger.com?REFERRALCODE=1CARLOS05" target="_blank" rel="noopener noreferrer" class="group relative rounded-xl overflow-hidden w-[800px] h-[300px] cursor-pointer">
            <img class="w-full h-full transition-transform duration-500 ease-in-out object-contain rounded-xl hover:scale-105" src="https://img.aimashen.com/1111.png" alt="Image Description">
        </a>
    </div>
    <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full">
        <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
            <h2 class="text-3xl font-bold text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight">
                码神经验分享
            </h2>
            <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
                分销团队实操经验
            </p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {
                posts.map(b => (
                    <BlogInsight blog={b} />
                ))
            }
        </div>
    </section>

    <HeroSectionAlt
        title="还有哪里可以找到我"
        subTitle="视频号、小红书、YouTube、抖音、B站、小宇宙同步发布"
        url="1"
    />
</BaseLayout>
